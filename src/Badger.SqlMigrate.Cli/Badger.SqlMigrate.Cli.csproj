<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Badger.SqlMigrate.Core\Badger.SqlMigrate.Core.csproj" />
    <ProjectReference Include="..\Badger.SqlMigrate.Connectivity\Badger.SqlMigrate.Connectivity.csproj" />
    <ProjectReference Include="..\Badger.SqlMigrate.Providers.PostgreSql\Badger.SqlMigrate.Providers.PostgreSql.csproj" />
    <ProjectReference Include="..\Badger.SqlMigrate.Providers.SqlServer\Badger.SqlMigrate.Providers.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package page shows docs/nuget/README.md: written for users, unlike the repository README. -->
    <None Include="..\..\docs\nuget\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\nuget\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- MCP server for 'bsm mcp' (MIT). Core only: stdio without the hosting stack. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 'bsm ai-guide', the MCP guide tool and AGENTS.md for new projects. -->
    <EmbeddedResource Include="..\..\docs\ai-guide.md" LogicalName="Badger.SqlMigrate.Cli.ai-guide.md" />
    <EmbeddedResource Include="Resources\AGENTS.md" LogicalName="Badger.SqlMigrate.Cli.AGENTS.md" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>bsm</AssemblyName>
    <RootNamespace>Badger.SqlMigrate.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bsm</ToolCommandName>
    <PackageId>Badger.SqlMigrate</PackageId>
    <Description>Badger SQL Migrate: free, cross-platform, hash-certified database migrations for SQL Server, Azure SQL and PostgreSQL, with real up and down, named changes, environments, Entra ID and Always Encrypted.</Description>
    <PackageTags>sql-server;azure-sql;postgresql;migrations;database;schema;devops;cli;entra-id;always-encrypted</PackageTags>
    <PackageProjectUrl>https://lonebadger.tech/badger-sql-migrate/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://lonebadger.tech/badger-sql-migrate/releases/</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/lonebadger-tech/badger-sql-migrate</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

</Project>
